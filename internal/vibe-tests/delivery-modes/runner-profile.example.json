{
  "schemaVersion": 2,
  "sandbox": {
    "root": "/isolated-run",
    "projectDir": "/isolated-run/project"
  },
  "browserHelper": {
    "name": "screenshot",
    "usage": "screenshot <file-or-url> [output.png]",
    "probeArgs": ["--help"]
  },
  "launcher": {
    "command": "/path/to/isolation-launcher",
    "args": [
      "--private-root",
      "{privateRoot}",
      "--sandbox-root",
      "{sandboxRoot}",
      "--cwd",
      "{runnerCwd}",
      "--",
      "{runnerCommand}",
      "{runnerArgs}"
    ]
  },
  "preflight": {
    "command": "/bin/sh",
    "args": ["-lc", "test -r input.txt && printf isolated"],
    "cwd": "{sandboxProject}"
  },
  "runners": {
    "example-agent": {
      "command": "/path/to/agent-cli",
      "args": [
        "--workspace",
        "{sandboxProject}",
        "--task-file",
        "{taskFile}",
        "--json"
      ],
      "stdin": "prompt",
      "versionArgs": ["--version"],
      "limits": {
        "maxModelSteps": 80
      },
      "capabilities": {
        "expected": {
          "builtIns": ["read", "shell", "write"],
          "skills": ["ui-authoring"],
          "mcpServers": ["browser"],
          "hooks": ["before-tool"],
          "plugins": []
        },
        "probe": {
          "command": "/path/to/capability-adapter",
          "args": ["--runner", "{runnerCommand}"],
          "cwd": "{sandboxProject}"
        }
      },
      "transcript": {
        "format": "jsonl",
        "toolCalls": [
          {
            "matches": [{"path": "kind", "equals": "tool-call"}],
            "commandPath": "payload.command"
          }
        ],
        "usage": {
          "matches": [{"path": "kind", "equals": "usage"}],
          "inputTokensPath": "payload.inputTokens",
          "outputTokensPath": "payload.outputTokens"
        }
      },
      "audit": {
        "rules": [
          {
            "label": "runner emitted its initialization receipt",
            "source": "stdout",
            "kind": "required",
            "class": "strict",
            "pattern": "initialization"
          },
          {
            "label": "runner reported a non-fatal compatibility warning",
            "source": "stderr",
            "kind": "forbidden",
            "class": "adjusted",
            "pattern": "compatibility warning",
            "flags": "i"
          }
        ]
      }
    }
  },
  "judge": {
    "command": "/path/to/judge-cli",
    "args": [
      "--workspace",
      "{sandboxProject}",
      "--schema",
      "{schema}",
      "--json"
    ],
    "stdin": "prompt",
    "resultPath": "payload.result",
    "transcript": {
      "format": "jsonl",
      "toolCalls": []
    },
    "audit": {
      "rules": []
    }
  }
}
